path <- "Time_series.qmd"
lines <- readLines(path, encoding = "UTF-8")
n <- length(lines)
out <- character(0)
fig_n <- 0
tab_n <- 0
i <- 1
while (i <= n) {
line <- lines[i]
if (grepl("^```\\{r", line)) {
j <- i + 1
while (j <= n && lines[j] != "```") j <- j + 1
chunk_content <- lines[(i+1):(j-1)]
is_fig <- any(grepl("ggplot\\(", chunk_content))
is_tab <- any(grepl("tab_ME\\(|tab_tbl\\(", chunk_content))
if (is_fig) {
fig_n <- fig_n + 1
out <- c(out, "\\", paste0("Рисунок ", fig_n), "")
} else if (is_tab) {
tab_n <- tab_n + 1
out <- c(out, "\\", paste0("Таблица ", tab_n), "")
}
out <- c(out, lines[i:j])
i <- j + 1
} else {
out <- c(out, line)
i <- i + 1
}
}
writeLines(out, path, useBytes = TRUE)
c(figures = fig_n, tables = tab_n)
library(labelled)
sapply(c("Group_inc","Age_inc","Group_count","Age_count","Group_count_pct","Age_count_pct","Year","Region","Group","Age","Status"), function(v) var_label(df[[v]]))
list(Group = unique(df$Group), Age = unique(df$Age), Region = unique(df$Region), Status = unique(df$Status))
statuses <- c("Первичный" = "первичной", "Повторный" = "повторной")
sections <- c("Уровень", "Количество")
groups <- list(
list(key = "Всего", header = "Без разделения на группы и возрастные категории.", cat = NULL),
list(key = "I",     header = "I категория инвалидности", cat = "лиц I группы инвалидности"),
list(key = "II",    header = "II категория инвалидности", cat = "лиц II группы инвалидности"),
list(key = "III",   header = "III категория инвалидности", cat = "лиц III группы инвалидности"),
list(key = "18-44", header = "Возраст 18-44", cat = "лиц в возрасте 18-44 года"),
list(key = "45-59", header = "Возраст жен 45-54, 45-59 муж", cat = "лиц в возрасте 45-54 года (женщины) и 45-59 лет (мужчины)"),
list(key = "60+",   header = "Возраст жен старше 50, муж старше 60", cat = "лиц в возрасте старше 50 лет (женщины) и старше 60 лет (мужчины)")
)
geo_okrug <- "по Дальневосточному федеральному округу в целом"
geo_overlay <- "по регионам округа"
geo_facet <- "по регионам округа (по отдельным субъектам)"
geo_model <- "по регионам округа с линией тренда и 95% ДИ"
fig_n <- 0
tab_n <- 0
rows <- list()
add_fig <- function(title, header_path) {
fig_n <<- fig_n + 1
rows[[length(rows) + 1]] <<- list(type = "Рисунок", n = fig_n, title = title, path = header_path)
}
add_tab <- function(title, header_path) {
tab_n <<- tab_n + 1
rows[[length(rows) + 1]] <<- list(type = "Таблица", n = tab_n, title = title, path = header_path)
}
for (status_ru in statuses) {
status_header <- names(statuses)[statuses == status_ru]
for (section in sections) {
metric_base <- if (section == "Уровень") {
paste0("Уровень ", status_ru, " инвалидности (на 10 тыс. населения)")
} else {
paste0("Число случаев ", status_ru, " инвалидности (абс.)")
}
metric_pct <- paste0("Доля случаев ", status_ru, " инвалидности от общего числа по округу (%)")
for (g in groups) {
cat_suffix <- if (is.null(g$cat)) "" else paste0(" среди ", g$cat)
path <- paste0(status_header, " инвалидность / ", section, " инвалидности / ", g$header)
if (section == "Уровень") {
add_fig(paste0(metric_base, cat_suffix, ", ", geo_okrug), path)
add_fig(paste0(metric_base, cat_suffix, ", ", geo_overlay), path)
add_fig(paste0(metric_base, cat_suffix, ", ", geo_facet), path)
add_tab(paste0("Различия среднегодовой динамики уровня ", status_ru, " инвалидности", cat_suffix, " между регионами округа (95% ДИ)"), path)
add_fig(paste0(metric_base, cat_suffix, ", ", geo_model), path)
} else {
add_fig(paste0(metric_base, cat_suffix, ", ", geo_okrug), path)
add_fig(paste0(metric_base, cat_suffix, ", ", geo_overlay), path)
add_fig(paste0(metric_pct, cat_suffix, ", ", geo_overlay), path)
add_fig(paste0(metric_pct, cat_suffix, ", ", geo_facet), path)
add_tab(paste0("Различия среднегодовой динамики доли случаев ", status_ru, " инвалидности", cat_suffix, " между регионами округа (95% ДИ)"), path)
add_fig(paste0(metric_pct, cat_suffix, ", ", geo_model), path)
}
}
}
}
length(rows)
c(fig_n = fig_n, tab_n = tab_n)
paths <- vapply(rows, function(r) r$path, character(1))
upaths <- unique(paths)
lines_out <- character(0)
for (p in upaths) {
lines_out <- c(lines_out, paste0("== ", p, " =="))
idx <- which(paths == p)
for (i in idx) {
r <- rows[[i]]
lines_out <- c(lines_out, paste0(r$type, " ", r$n, ". ", r$title))
}
lines_out <- c(lines_out, "")
}
writeLines(lines_out)
writeLines(lines_out, "titles_draft.txt")
length(lines_out)
path <- "Time_series.qmd"
lines <- readLines(path, encoding = "UTF-8")
titles <- vapply(rows, function(r) paste0(r$type, " ", r$n, ". ", r$title), character(1))
idx <- which(grepl("^(Рисунок|Таблица) [0-9]+$", lines))
length(idx) == length(titles)
lines[idx] <- titles
writeLines(lines, path, useBytes = TRUE)
length(idx)
path <- "Time_series.qmd"
lines <- readLines(path, encoding = "UTF-8")
n_lines <- length(lines)
fence_idx <- which(grepl("^```\\{r", lines))
chunks <- list()
i <- 1
while (i <= n_lines) {
if (grepl("^```\\{r", lines[i])) {
j <- i + 1
while (j <= n_lines && lines[j] != "```") j <- j + 1
chunks[[length(chunks) + 1]] <- list(start = i, end = j, body = paste(lines[(i+1):(j-1)], collapse = "\n"))
i <- j + 1
} else {
i <- i + 1
}
}
length(chunks)
status_state <- NA
metric_state <- NA
cat_state <- NA
status_abbr <- c(Первичный = "prim", Повторный = "rep")
cat_abbr <- c(
"Всего" = "all",
"I" = "g1", "II" = "g2", "III" = "g3"
)
age_abbr <- c(
"18-44" = "a1",
"жен 45-54, 45-59 муж" = "a2",
"жен старше 50, муж старше 60" = "a3"
)
get_status <- function(body) {
if (grepl('Status == "Первичный"', body)) return("Первичный")
if (grepl('Status == "Повторный"', body)) return("Повторный")
NA
}
get_metric <- function(body) {
if (grepl("Group_count_pct", body)) return("pct")
if (grepl("Age_count_pct", body)) return("pct")
if (grepl("Group_count", body)) return("cnt")
if (grepl("Age_count", body)) return("cnt")
if (grepl("Group_inc", body)) return("rate")
if (grepl("Age_inc", body)) return("rate")
NA
}
get_cat <- function(body) {
m <- regmatches(body, regexec('Group == "(Всего|I|II|III)"', body))[[1]]
if (length(m) > 0) return(cat_abbr[[m[2]]])
m <- regmatches(body, regexec('Age == "(18-44|жен 45-54, 45-59 муж|жен старше 50, муж старше 60)"', body))[[1]]
if (length(m) > 0) return(age_abbr[[m[2]]])
NA
}
roles <- character(length(chunks))
labels <- character(length(chunks))
for (k in seq_along(chunks)) {
body <- chunks[[k]]$body
st <- get_status(body); if (!is.na(st)) status_state <- st
met <- get_metric(body); if (!is.na(met)) metric_state <- met
ct <- get_cat(body); if (!is.na(ct)) cat_state <- ct
is_setup <- grepl("label: setup", body)
is_prep_grp <- grepl("df_count <-", body) && grepl("group_by\\(Year, Group\\)", body)
is_prep_age <- grepl("df_count <-", body) && grepl("group_by\\(Year, Age\\)", body)
is_tsibble <- grepl("TSLM\\(", body)
is_table <- grepl("tab_ME\\(", body)
is_calc_max <- grepl("max_inc <-", body) && grepl("avg_predictions\\(", body)
is_calc_trend <- grepl("avg_comparisons\\(", body) && !is_table && !is_calc_max && grepl("md_all", body)
has_ggplot <- grepl("ggplot\\(", body)
has_ribbon <- grepl("geom_ribbon\\(", body)
has_facet <- grepl("facet_wrap\\(", body)
has_color_region <- grepl("color = Region", body)
if (is_setup) {
role <- "setup"
} else if (is_prep_grp) {
role <- "prep-pct-grp"
} else if (is_prep_age) {
role <- "prep-pct-age"
} else if (is_tsibble) {
role <- "explore-tsibble"
} else if (is_table) {
role <- "table-compare"
} else if (is_calc_max) {
role <- "calc-max"
} else if (is_calc_trend) {
role <- "calc-trend"
} else if (has_ggplot && has_ribbon && has_facet) {
role <- "plot-trend"
} else if (has_ggplot && has_facet) {
role <- "plot-facet"
} else if (has_ggplot && has_color_region) {
role <- "plot-overlay"
} else if (has_ggplot) {
role <- "plot-total"
} else {
role <- "unclassified"
}
roles[k] <- role
parts <- c(as.character(k), role)
if (!role %in% c("setup", "prep-pct-grp", "prep-pct-age", "explore-tsibble")) {
st_ab <- if (!is.na(status_state)) status_abbr[[status_state]] else "NA"
parts <- c(as.character(k), st_ab, if(!is.na(metric_state)) metric_state else "NA",
if(!is.na(cat_state)) cat_state else "NA", role)
} else if (role %in% c("prep-pct-grp", "prep-pct-age")) {
st_ab <- if (!is.na(status_state)) status_abbr[[status_state]] else "NA"
parts <- c(as.character(k), st_ab, role)
}
labels[k] <- paste(parts, collapse = "-")
}
table(roles)
sum(roles == "unclassified")
cat(head(labels, 20), sep = "\n")
cat("...\n")
sum(duplicated(labels))
which(duplicated(labels))
idx_prep <- which(roles %in% c("prep-pct-grp", "prep-pct-age"))
cat(labels[idx_prep], sep = "\n")
cat("---count block sample---\n")
cat(labels[which(labels == "1-setup")+1] , "\n")
start <- grep("^[0-9]+-prim-cnt", labels)[1]
cat(labels[start:(start+8)], sep = "\n")
cat("---repeat block sample---\n")
start2 <- grep("^[0-9]+-rep-rate", labels)[1]
cat(labels[start2:(start2+8)], sep = "\n")
cat("---tail---\n")
cat(tail(labels, 10), sep = "\n")
path <- "Time_series.qmd"
lines <- readLines(path, encoding = "UTF-8")
# Remove existing label for setup chunk (will replace with numbered one)
setup_label_idx <- grep('^#\\| label: setup$', lines)
setup_label_idx
out <- character(0)
last_end <- 0
for (k in seq_along(chunks)) {
ch <- chunks[[k]]
out <- c(out, lines[(last_end+1):(ch$start)])
# ch$start line is the ```{r} fence itself already appended above
out <- c(out, paste0("#| label: ", labels[k]))
last_end <- ch$start
}
out <- c(out, lines[(last_end+1):length(lines)])
# Remove the old duplicate '#| label: setup' line (now redundant)
out <- out[!grepl('^#\\| label: setup$', out)]
writeLines(out, path, useBytes = TRUE)
length(out) - length(lines)
