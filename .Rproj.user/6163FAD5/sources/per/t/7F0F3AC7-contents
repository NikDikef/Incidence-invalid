```{r}
#| label: 6-prim-rate-all-calc-max

fit <- df |> 
 filter(Region != "Всего", Group == "Всего", Status == "Первичный") |> 
 mutate(Time_ID = row_number(),
        Year_new = Year - 2019) |> 
 lm(Group_inc ~ Region * Year_new, 
     data = _) 

max_inc <- avg_predictions(fit, by = "Region") |> 
 tibble() |> 
 select(Region, estimate) |> 
 arrange(desc(estimate))
```
\
Наибольший `r attr(df$Group_inc, "label")` наблюдается в `r max_inc[1, 1]`.

\
Таблица 1. Различия среднегодовой динамики уровня первичной инвалидности между регионами округа (95% ДИ)

```{r}
#| label: 7-prim-rate-all-table-compare
tab <- fit |> 
 avg_comparisons(variables = "Year_new", by = "Region", vcov = "HAC")

sign <- tab |> 
 filter(p.value < 0.05) |> 
 pull(Region)  |> 
 as.character() |> 
 stringr::str_flatten_comma()

tab |> 
 mutate(`Разность средних\n(95% ДИ)` = paste0(
  round(estimate, 3), "\n(",
  round(conf.low, 3), "; ",
  round(conf.high, 3), ")"
 ),
 `p-value` = ifelse(p.value < 0.001, "<0.001", round(p.value, 3))) |> 
 select(Region, `Разность средних\n(95% ДИ)`, `p-value`) |> 
 tab_ME() |> 
 align(j = 2:3, align = "center", part = "all") |> 
 bg(i = ~ `p-value` < 0.05 | `p-value` == "<0.001", bg = "#C9E7FA", part = "body")
```
\
Значимое увеличение динамики инвалидности выявлены в `r sign`.

\
Рисунок 4. Уровень первичной инвалидности (на 10 тыс. населения), по регионам округа с линией тренда и 95% ДИ

```{r}
#| label: 8-prim-rate-all-plot-trend
#| fig-align: "center"
#| fig-dpi: 400
#| fig-width: 9
#| fig-height: 8

df_lm <- fit |> 
 avg_predictions(by = c("Year_new", "Region"), vcov = "HAC") |> 
 mutate(Year = Year_new + 2019) |> 
 tibble()

df |> 
 filter(Region != "Всего", Group == "Всего", Status == "Первичный") |> 
 left_join(df_lm) |> 
 ggplot(aes(Year, Group_inc)) +
 geom_line(linetype = 2) +
 geom_point(show.legend = F, size = 4) +
 geom_line(aes(Year, estimate), color = "blue", linewidth = 1) +
 geom_ribbon(aes(Year, ymax = conf.high, ymin = conf.low), alpha = 0.1, show.legend = F,
             fill = "blue") +
 facet_wrap(~Region, ncol = 3) +
 coord_cartesian(ylim = c(0, 10)) +
 theme(axis.text.x = element_text(size = 10),
       strip.text = element_text(size = 14), 
       panel.grid.minor.x = element_blank())
```

Точка -- значение показателя на указанный момент времени.


